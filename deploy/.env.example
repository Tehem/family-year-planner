# Family Year Planner — environment (copy to /opt/annee/.env, keep it private: chmod 600)

# Domain served by Caddy (no scheme).
DOMAIN=famille.example.org

APP_MODE=prod
APP_CONFIG=/config/config.toml
BIND=0.0.0.0:8080
DATABASE_URL=sqlite:///data/annee.db
RUST_LOG=info,annee_server=info

# Google service account key (mounted from ./secrets).
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/service-account.json

# Google Sign-In web client (Google Cloud console → Google Auth Platform → Clients).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Cookie encryption/signing key: 64 random bytes, base64 on one line.
#   openssl rand -base64 64 | tr -d '\n'
SESSION_KEY=

# Ed25519 seed that signs OAuth access tokens: base64 of 32 random bytes.
#   openssl rand -base64 32
OAUTH_SIGNING_KEY=

# Only for docker-compose.shared-proxy.yml: name of the Docker network of the existing reverse proxy.
# PROXY_NETWORK=proxy-network
